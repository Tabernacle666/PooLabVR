+uint32_t AppendWaterPipe(SceneData& scene,float diameter,float length){
+    auto& mesh=scene.meshes;
+    MeshRange range{};
+    range.firstVertex=uint32_t(mesh.vertices.size());
+    range.firstIndex=uint32_t(mesh.indices.size());
+    range.firstMeshlet=uint32_t(mesh.meshlets.size());
+    constexpr uint32_t sides=32u;
+    const float radius=diameter*.5f,half=length*.5f;
+    for(uint32_t i=0;i<=sides;++i){
+        const float u=float(i)/float(sides);
+        const float angle=(i==sides?0.f:u)*2.f*Pi;
+        const XMFLOAT3 normal{std::cos(angle),0.f,std::sin(angle)};
+        const float x=radius*normal.x,z=radius*normal.z;
+        const float around=u*Pi*diameter;
+        mesh.vertices.push_back({{x,-half,z},normal,{around,0.f}});
+        mesh.vertices.push_back({{x,half,z},normal,{around,length}});
+        if(i>0){
+            const uint32_t v=range.firstVertex+(i-1u)*2u;
+            mesh.indices.insert(mesh.indices.end(),{v,v+1u,v+2u,v+1u,v+3u,v+2u});
+        }
+    }
+    for(float sign:{-1.f,1.f}){
+        const uint32_t center=uint32_t(mesh.vertices.size());
+        const XMFLOAT3 normal{0.f,sign,0.f};
+        mesh.vertices.push_back({{0.f,sign*half,0.f},normal,{0.f,0.f}});
+        for(uint32_t i=0;i<sides;++i){
+            const auto& p=mesh.vertices[range.firstVertex+2u*i].position;
+            mesh.vertices.push_back({{p.x,sign*half,p.z},normal,{p.x,p.z}});
+        }
+        for(uint32_t i=0;i<sides;++i){
+            const uint32_t a=center+1u+i,b=center+1u+(i+1u)%sides;
+            if(sign<0.f)mesh.indices.insert(mesh.indices.end(),{center,a,b});
+            else mesh.indices.insert(mesh.indices.end(),{center,b,a});
+        }
+    }
+    FinishRange(mesh,range);
+    const auto index=uint32_t(mesh.ranges.size());
+    mesh.ranges.push_back(range);
+    mesh.deformations.emplace_back();mesh.motions.emplace_back();
+    mesh.skin.resize(mesh.vertices.size());
+    return index;
