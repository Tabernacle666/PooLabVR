#ifndef OASIS_DEBRIS_LAYOUT
#define OASIS_DEBRIS_LAYOUT

#define DEBRIS_RING_SIZE 512u
#define DEBRIS_RING_BASE 4u
#define DEBRIS_RING_STRIDE 2u
#define DEBRIS_DRAW_BASE (DEBRIS_RING_BASE + DEBRIS_RING_SIZE * DEBRIS_RING_STRIDE)
#define DEBRIS_DRAW_BLOCK 64u
#define DEBRIS_MAX_DRAW_BLOCKS 384u
#define DEBRIS_FLOOR_SIZE 160u
#define DEBRIS_FLOOR_CELLS (1u + DEBRIS_FLOOR_SIZE * DEBRIS_FLOOR_SIZE)

#endif
